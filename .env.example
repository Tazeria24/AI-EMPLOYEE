# Copy this file to .env.local and fill in real values.
# .env* files are gitignored — never commit real secrets.

# --- Supabase (public: safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only secret) ---
# The service-role key bypasses RLS. Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers ---
# Embedding provider used by the knowledge base. Only "stub" is implemented:
# a deterministic local embedder for development/testing (no network, no cost).
# A production provider is pending ADR-008/ADR-009 and must emit 1536-dim
# vectors or the knowledge schema needs a migration + re-embed.
EMBEDDING_PROVIDER=stub

# --- Site URL (optional) ---
# Used to build email redirect links (verification, password reset).
# Falls back to request headers if unset. Set this in production, e.g.
# https://your-domain.com
NEXT_PUBLIC_SITE_URL=
