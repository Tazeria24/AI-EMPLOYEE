# Copy this file to .env.local and fill in real values.
# .env* files are gitignored — never commit real secrets.

# --- Supabase (public: safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only secret) ---
# The service-role key bypasses RLS. Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers ---
# Chat model for the AI employee. Claude Sonnet 5 (ADR-008). Server-only secret.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Embedding provider for the knowledge base (ADR-009).
#   voyage -> Voyage AI `voyage-4`, 1024 dims (production). Requires VOYAGE_API_KEY.
#   stub   -> deterministic local embedder: no network, no cost, used by tests
#             and for local development. Lexical only — never use in production.
# A provider must emit 1024-dim vectors or the schema needs a migration and a
# full re-embed.
EMBEDDING_PROVIDER=stub
VOYAGE_API_KEY=

# --- Automations ---
# Shared secret for the Vercel Cron endpoint (POST /api/cron/automations).
# The endpoint is a public URL: without this it returns 401 and does nothing.
# Generate a long random value; it is compared in constant time.
CRON_SECRET=

# --- Email follow-up (optional) ---
# Resend, used only when an automation is configured to deliver by email.
# Without both values, email follow-ups are recorded as failed rather than sent.
RESEND_API_KEY=
FOLLOW_UP_FROM_EMAIL=

# --- WhatsApp (Milestone 10) ---
# There are NO WhatsApp environment variables. Each business connects their own
# number, so the phone number id, verify token, app secret and access token are
# stored per organization in the database (migration 0009) and set from
# /dashboard/whatsapp. The secret columns are write-only: the dashboard can set
# them and can never read them back.

# --- Site URL (optional) ---
# Used to build email redirect links (verification, password reset).
# Falls back to request headers if unset. Set this in production, e.g.
# https://your-domain.com
NEXT_PUBLIC_SITE_URL=
